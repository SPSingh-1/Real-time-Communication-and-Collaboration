# Top-level .gitignore

# Ignore node_modules in all directories
node_modules/
**/node_modules/
Client/node_modules/
Server/node_modules/

# Ignore build folders
dist/
build/
Client/build/

# Ignore .env files in all directories
.env
*.env
Client/.env
Server/.env

# Common OS and IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Any other global logs or temp files
*.log